# Python cache
__pycache__/
*.py[cod]

# Local verification and packaging helpers（仅限仓库根散置脚本；
# tests/ 下的正式用例不受影响 —— P12·W1.0 起护栏用例入库）
/test_*.py
scripts/
packaging/

# Local runtime cache, regenerated automatically
config.json

# PyInstaller generated output
build/
dist/
*.spec
!packaging/pyinstaller/*.spec

# Release bundles generated by scripts/build_min.ps1
releases/

# Keep only the SDK DLLs required at runtime
everything-SDK/*
!everything-SDK/dll/
everything-SDK/dll/*
!everything-SDK/dll/Everything32.dll
!everything-SDK/dll/Everything64.dll

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
Desktop.ini
